# =============================================================================
# TP Final G11 - Variables de entorno
# =============================================================================
# Este archivo SI va al repo, a proposito: asi el stack levanta con un solo
# comando. Son credenciales de juguete. La API de USGS no necesita key.
# =============================================================================

# Docker en Windows: convierte C:\ruta a /c/ruta en los bind mounts
COMPOSE_CONVERT_WINDOWS_PATHS=1

# Puertos del HOST (si alguno esta ocupado, cambialo aca)
AIRFLOW_PORT=8080
DASHBOARD_PORT=8501
WAREHOUSE_PORT=5432

# --- Warehouse (bronze / silver / gold) ---
SOURCE_DB_USER=admin
SOURCE_DB_PASS=admin
SOURCE_DB_NAME=sismos

# --- Metadatos de Airflow ---
AF_DB_USER=airflow
AF_DB_PASS=airflow
AF_DB_NAME=airflow

# --- Airflow ---
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__PARALLELISM=4
AIRFLOW__CORE__MAX_ACTIVE_TASKS_PER_DAG=4
# Los DAGs nuevos nacen activos (ademas, cada DAG lo declara con
# is_paused_upon_creation=False)
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=False
# Que el dag-processor vea rapido los DAGs al levantar
AIRFLOW__DAG_PROCESSOR__REFRESH_INTERVAL=10
# Claves internas de Airflow (firma de sesiones y de los tokens entre sus
# procesos). Valores de juguete, cortos y legibles a proposito: un valor largo
# y "aleatorio" en una variable llamada *SECRET* lo marca como secreto filtrado
# el escaner GitGuardian del repo, aunque sea falso.
AIRFLOW__API__SECRET_KEY=secret_key_de_juguete
AIRFLOW__API_AUTH__JWT_SECRET=jwt_secret_de_juguete

# --- Login de la UI de Airflow (Simple Auth Manager de Airflow 3) ---
# Usuario admin con rol admin. La contrasena la fija init-airflow.sh.
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_USERS=admin:admin
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_PASSWORDS_FILE=/opt/airflow/simple_auth_manager_passwords.json
AIRFLOW_ADMIN_PASSWORD=admin
