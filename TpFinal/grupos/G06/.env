# Variables del stack G06: asi el stack levanta con un solo comando. 
# Open-Meteo no necesita API key.

# En Windows convierte C:\... a /c/... para los bind mounts
COMPOSE_CONVERT_WINDOWS_PATHS=1

# Postgres del pipeline (warehouse)
SOURCE_DB_USER=admin
SOURCE_DB_PASS=admin
SOURCE_DB_NAME=openmeteo
SOURCE_DB_PORT=5432

# Postgres interno de Airflow
AF_DB_USER=airflow
AF_DB_PASS=airflow
AF_DB_NAME=airflow

# Airflow
AIRFLOW_SECRET_KEY=g06-openmeteo-clave-de-juguete
# Login de la UI: usuario admin, rol admin.
# La contrasena sale de airflow/passwords.json (admin / admin).
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_USERS=admin:admin
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_PASSWORDS_FILE=/opt/airflow/passwords.json
